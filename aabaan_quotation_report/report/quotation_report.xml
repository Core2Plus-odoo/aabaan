<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Letterhead paper format: tall margins reserve space for the angular
         header band and the offices footer on every page. -->
    <record id="paperformat_aabaan_quotation" model="report.paperformat">
        <field name="name">Aabaan Letterhead A4</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">46</field>
        <field name="margin_bottom">46</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">40</field>
        <field name="dpi">90</field>
    </record>

    <template id="report_saleorder_document_aabaan">
        <t t-set="company" t-value="doc.company_id.sudo()"/>
        <t t-set="is_quote" t-value="doc.state in ('draft', 'sent')"/>
        <t t-set="has_discount" t-value="any(l.discount for l in doc.order_line if not l.display_type)"/>

        <!-- Letterhead header: black angular band, orange slash, logo right -->
        <div class="header">
            <table style="width: 100%; border-collapse: collapse; font-family: Helvetica, Arial, sans-serif;">
                <tr>
                    <td style="vertical-align: top; padding: 0;">
                        <table style="width: 100%; border-collapse: collapse; margin-top: 8px;">
                            <tr>
                                <td style="width: 58%; background-color: #1A1A1C; height: 15px; padding: 0;"/>
                                <td style="width: 24px; padding: 0; vertical-align: top;">
                                    <div style="width: 0; height: 0; border-left: 24px solid #1A1A1C; border-bottom: 15px solid transparent;"/>
                                </td>
                                <td style="width: 18px; padding: 0; vertical-align: top;">
                                    <div style="width: 0; height: 0; border-bottom: 15px solid #EF7D25; border-left: 18px solid transparent;"/>
                                </td>
                                <td style="background-color: #EF7D25; height: 15px; padding: 0;"/>
                            </tr>
                        </table>
                        <table style="width: 72%; border-collapse: collapse; margin-top: 4px;">
                            <tr>
                                <td style="background-color: #1A1A1C; height: 10px; padding: 0;"/>
                                <td style="width: 18px; padding: 0; vertical-align: top;">
                                    <div style="width: 0; height: 0; border-left: 18px solid #1A1A1C; border-bottom: 10px solid transparent;"/>
                                </td>
                            </tr>
                        </table>
                    </td>
                    <td style="width: 200px; text-align: right; vertical-align: top; padding: 0 0 0 14px;">
                        <img t-if="company.logo" t-att-src="image_data_uri(company.logo)"
                             style="max-height: 62px; max-width: 185px;" alt="Logo"/>
                        <div t-else="" style="font-size: 20px; font-weight: bold; color: #EF7D25;"
                             t-esc="company.name"/>
                        <div style="font-size: 7.5px; color: #EF7D25; font-weight: bold; margin-top: 2px;">
                            One Stop for Every Service Need!
                        </div>
                    </td>
                </tr>
            </table>
        </div>

        <!-- Document body -->
        <div class="article" t-att-data-oe-model="doc._name" t-att-data-oe-id="doc.id">
            <div style="font-family: Helvetica, Arial, sans-serif; color: #1A1A1C; font-size: 10px; line-height: 1.4;">

                <!-- Customer name + title / ref block -->
                <table style="width: 100%; border-collapse: collapse;">
                    <tr>
                        <td style="vertical-align: top; padding-top: 8px;">
                            <div style="font-size: 12px; font-weight: bold; text-transform: uppercase;"
                                 t-esc="doc.partner_id.name"/>
                            <div style="font-size: 9px; color: #58585E; margin-top: 2px;"
                                 t-field="doc.partner_id"
                                 t-options='{"widget": "contact", "fields": ["address"], "no_marker": true}'/>
                            <div t-if="doc.partner_id.vat" style="font-size: 9px; color: #58585E;">
                                TRN: <span t-esc="doc.partner_id.vat"/>
                            </div>
                        </td>
                        <td style="width: 250px; vertical-align: top; text-align: right;">
                            <div style="font-size: 17px; font-weight: bold;">
                                <t t-if="is_quote">Quotation</t>
                                <t t-else="">Contract</t>
                            </div>
                            <table style="width: 100%; border-collapse: collapse; font-size: 9.5px; margin-top: 5px;">
                                <tr>
                                    <td style="background-color: #FDEBDC; color: #EF7D25; font-weight: bold; padding: 4px 7px; text-align: left;">Ref#</td>
                                    <td style="background-color: #FDEBDC; color: #EF7D25; font-weight: bold; padding: 4px 7px; text-align: right;"
                                        t-esc="doc.name"/>
                                </tr>
                                <tr>
                                    <td style="padding: 4px 7px; border-bottom: 1px solid #ECECEE; text-align: left;">Date</td>
                                    <td style="padding: 4px 7px; border-bottom: 1px solid #ECECEE; text-align: right; font-weight: bold;">
                                        <t t-if="doc.date_order" t-esc="doc.date_order.strftime('%d-%b-%Y')"/>
                                    </td>
                                </tr>
                                <tr t-if="is_quote and doc.validity_date">
                                    <td style="padding: 4px 7px; border-bottom: 1px solid #ECECEE; text-align: left;">Valid Until</td>
                                    <td style="padding: 4px 7px; border-bottom: 1px solid #ECECEE; text-align: right; font-weight: bold;"
                                        t-esc="doc.validity_date.strftime('%d-%b-%Y')"/>
                                </tr>
                                <tr t-if="doc.client_order_ref">
                                    <td style="padding: 4px 7px; border-bottom: 1px solid #ECECEE; text-align: left;">LPO / Ref</td>
                                    <td style="padding: 4px 7px; border-bottom: 1px solid #ECECEE; text-align: right; font-weight: bold;"
                                        t-esc="doc.client_order_ref"/>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </table>

                <!-- Subject -->
                <div t-if="doc._aabaan_subject()" style="margin-top: 12px;">
                    <span style="font-weight: bold;">Subject : </span>
                    <span style="font-style: italic; font-weight: bold;" t-esc="doc._aabaan_subject()"/>
                </div>

                <!-- First / Second Party intro -->
                <div style="margin-top: 8px;">
                    The First Party <span style="font-weight: bold;" t-esc="company.name"/>
                    and The Second Party <span style="font-weight: bold;" t-esc="doc.partner_id.name"/>
                    have agreed to the services listed herein on the following terms and conditions:
                </div>

                <!-- Contract articles: the order's terms, carried by the
                     quotation templates from the signed agreements -->
                <div t-if="doc.note" t-out="doc.note"
                     style="margin-top: 10px; font-size: 9.5px; line-height: 1.45;"/>

                <!-- Line items -->
                <table style="width: 100%; border-collapse: collapse; font-size: 9.5px; margin-top: 14px;">
                    <thead>
                        <tr style="background-color: #EF7D25; color: #ffffff; font-weight: bold;">
                            <td style="width: 26px; padding: 6px 4px; text-align: center;">&#160;</td>
                            <td style="padding: 6px; text-align: center;">Description</td>
                            <td style="width: 52px; padding: 6px; text-align: center;">Unit</td>
                            <td style="width: 80px; padding: 6px; text-align: center;">Rate</td>
                            <td t-if="has_discount" style="width: 52px; padding: 6px; text-align: center;">Disc.%</td>
                            <td style="width: 95px; padding: 6px; text-align: center;">Grand Total</td>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="doc._aabaan_numbered_lines()" t-as="row">
                            <t t-set="line" t-value="row['line']"/>
                            <tr t-if="line.display_type == 'line_section'">
                                <td t-att-colspan="6 if has_discount else 5"
                                    style="background-color: #F4F4F5; font-weight: bold; padding: 5px 7px; border: 1px solid #D9D9D9;"
                                    t-esc="line.name"/>
                            </tr>
                            <tr t-elif="line.display_type == 'line_note'">
                                <td t-att-colspan="6 if has_discount else 5"
                                    style="font-style: italic; color: #58585E; padding: 4px 7px; border: 1px solid #D9D9D9;">
                                    <span t-field="line.name"/>
                                </td>
                            </tr>
                            <tr t-else="">
                                <td style="text-align: center; padding: 5px 4px; border: 1px solid #D9D9D9; vertical-align: top;"
                                    t-esc="row['no']"/>
                                <td style="padding: 5px 7px; border: 1px solid #D9D9D9; vertical-align: top;">
                                    <span t-field="line.name"/>
                                </td>
                                <td style="text-align: center; padding: 5px 4px; border: 1px solid #D9D9D9; vertical-align: top;"
                                    t-esc="'%g' % line.product_uom_qty"/>
                                <td style="text-align: right; padding: 5px 7px; border: 1px solid #D9D9D9; vertical-align: top;"
                                    t-out="line.price_unit"
                                    t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                <td t-if="has_discount"
                                    style="text-align: center; padding: 5px 4px; border: 1px solid #D9D9D9; vertical-align: top;"
                                    t-esc="'%g' % line.discount"/>
                                <td style="text-align: right; padding: 5px 7px; border: 1px solid #D9D9D9; vertical-align: top;"
                                    t-out="line.price_subtotal"
                                    t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                            </tr>
                        </t>
                    </tbody>
                </table>

                <!-- Totals -->
                <table style="width: 42%; margin-left: 58%; border-collapse: collapse; font-size: 9.5px; margin-top: 8px; page-break-inside: avoid;">
                    <tr>
                        <td style="padding: 3px 7px; text-align: left;">Subtotal (excl. VAT)</td>
                        <td style="padding: 3px 7px; text-align: right;"
                            t-out="doc.amount_untaxed"
                            t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                    </tr>
                    <tr>
                        <td style="padding: 3px 7px; text-align: left;">VAT</td>
                        <td style="padding: 3px 7px; text-align: right;"
                            t-out="doc.amount_tax"
                            t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                    </tr>
                    <tr style="font-weight: bold; font-size: 10.5px;">
                        <td style="padding: 4px 7px; text-align: left; border-top: 2px solid #EF7D25;">Grand Total</td>
                        <td style="padding: 4px 7px; text-align: right; border-top: 2px solid #EF7D25; color: #EF7D25;"
                            t-out="doc.amount_total"
                            t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                    </tr>
                </table>

                <div style="font-weight: bold; font-style: italic; margin-top: 8px; clear: both;">
                    Total Amount
                    <t t-out="doc.amount_total"
                       t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                    <t t-if="doc._aabaan_amount_in_words()">
                        (<t t-esc="doc._aabaan_amount_in_words()"/> Only)
                    </t>
                </div>

                <!-- Signatures -->
                <table style="width: 100%; border-collapse: collapse; margin-top: 36px; page-break-inside: avoid; font-size: 9.5px;">
                    <tr>
                        <td style="width: 46%; vertical-align: bottom;">
                            <div style="font-weight: bold;" t-esc="doc.partner_id.name"/>
                            <div style="height: 54px; margin-top: 6px;">
                                <img t-if="doc.signature" t-att-src="image_data_uri(doc.signature)"
                                     style="max-height: 50px;" alt="Signature"/>
                            </div>
                            <div style="border-top: 1px solid #1A1A1C; width: 75%;"/>
                            <div style="font-size: 8.5px; font-weight: bold; margin-top: 2px;">Signature</div>
                            <div t-if="doc.signed_by" style="font-size: 8.5px;">
                                Name: <t t-esc="doc.signed_by"/>
                                <t t-if="doc.signed_on"> — <t t-esc="doc.signed_on.strftime('%d-%b-%Y')"/></t>
                            </div>
                        </td>
                        <td style="width: 8%;"/>
                        <td style="width: 46%; vertical-align: bottom;">
                            <div style="font-weight: bold;">M/s. <t t-esc="company.name"/></div>
                            <div style="height: 54px; margin-top: 6px;"/>
                            <div style="border-top: 1px solid #1A1A1C; width: 75%;"/>
                            <div style="font-size: 8.5px; font-weight: bold; margin-top: 2px;">Signature</div>
                        </td>
                    </tr>
                </table>
            </div>
        </div>

        <!-- Letterhead footer: offices, contact, compliance, angular bar -->
        <div class="footer">
            <div style="font-family: Helvetica, Arial, sans-serif;">
                <div style="font-size: 7.5px; text-align: center; color: #9A9AA0; font-style: italic;">
                    Page <span class="page"/> of <span class="topage"/>
                </div>
                <table style="width: 100%; border-collapse: collapse; font-size: 8.5px; color: #1A1A1C; margin-top: 2px;">
                    <tr>
                        <td style="vertical-align: top;">
                            <div style="color: #EF7D25; font-weight: bold;">Head Office:</div>
                            <div>Office #126, Bin Saloom Building, Abu Hail, Deira, Dubai.</div>
                            <div style="color: #EF7D25; font-weight: bold; margin-top: 2px;">Branch Offices (UAE):</div>
                            <div>Shop #1 &amp; 2, Al Sharq, Al Butina, Sharjah.</div>
                            <div>Shop #1 &amp; 2, Mohammed Ali Building, Al Nuaimiya, Ajman.</div>
                        </td>
                        <td style="vertical-align: bottom; text-align: right;">
                            <div style="font-weight: bold;">+971 55 859 8834 | +971 800 22226</div>
                            <div>aabanservices@gmail.com</div>
                            <div style="color: #58585E; margin-top: 2px;">
                                <t t-if="company.vat">TRN: <span t-esc="company.vat"/></t>
                                <t t-if="company.company_registry"> &#183; Trade Licence No: <span t-esc="company.company_registry"/></t>
                            </div>
                        </td>
                    </tr>
                </table>
                <table style="width: 100%; border-collapse: collapse; margin-top: 4px;">
                    <tr>
                        <td style="width: 30%; background-color: #EF7D25; height: 10px; padding: 0;"/>
                        <td style="width: 16px; padding: 0; vertical-align: bottom;">
                            <div style="width: 0; height: 0; border-right: 16px solid #1A1A1C; border-top: 10px solid transparent;"/>
                        </td>
                        <td style="background-color: #1A1A1C; height: 10px; padding: 0;"/>
                    </tr>
                </table>
            </div>
        </div>
    </template>

    <template id="report_saleorder_aabaan">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang or doc.env.lang)"/>
                <t t-call="aabaan_quotation_report.report_saleorder_document_aabaan"/>
            </t>
        </t>
    </template>

    <!-- Redirect the default Quotation / Order PDF (print, email, portal) to
         the letterhead layout. Revert by pointing report_name back to
         sale.report_saleorder. -->
    <record id="sale.action_report_saleorder" model="ir.actions.report">
        <field name="report_name">aabaan_quotation_report.report_saleorder_aabaan</field>
        <field name="report_file">aabaan_quotation_report.report_saleorder_aabaan</field>
        <field name="paperformat_id" ref="aabaan_quotation_report.paperformat_aabaan_quotation"/>
    </record>

</odoo>
