<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_list_recovery" model="ir.ui.view">
        <field name="name">account.move.list.aabaan.recovery</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <list edit="1" create="0" decoration-danger="recovery_bucket == 'previous'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="invoice_date" optional="show"/>
                <field name="invoice_date_due"/>
                <field name="recovery_bucket"/>
                <field name="aabaan_services" optional="show"/>
                <field name="recovery_status" optional="show"/>
                <field name="recovery_promise_date" optional="show"/>
                <field name="payment_state"/>
                <field name="amount_total" sum="Total"/>
                <field name="amount_residual" sum="Outstanding"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>


    <!-- §5 recovery grid: entity × service rows, Previous/Current/Future
         columns, outstanding as the measure — one screen. -->
    <record id="view_move_pivot_recovery" model="ir.ui.view">
        <field name="name">account.move.pivot.aabaan.recovery</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <pivot sample="0">
                <field name="company_id" type="row"/>
                <field name="aabaan_services" type="row"/>
                <field name="recovery_bucket" type="col"/>
                <field name="amount_residual_signed" type="measure" string="Outstanding"/>
            </pivot>
        </field>
    </record>

    <record id="action_recovery_report" model="ir.actions.act_window">
        <field name="name">Recovery</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,pivot,form</field>
        <field name="view_id" ref="view_move_list_recovery"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_move_list_recovery')}),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_move_pivot_recovery')})]"/>
        <field name="domain">[('move_type', '=', 'out_invoice'), ('state', '=', 'posted'), ('payment_state', 'in', ('not_paid', 'partial'))]</field>
        <field name="context">{'group_by': 'recovery_bucket'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing to recover</p>
            <p>Open customer invoices appear here classified as Previous
               (before Aug 2026), Current and Future — filter and group by
               branch and service via the analytic dimensions.</p>
        </field>
    </record>

    <menuitem id="menu_recovery_report" name="Recovery"
              parent="account.menu_finance_receivables"
              action="aabaan_finance_core.action_recovery_report"
              sequence="9"/>
</odoo>
