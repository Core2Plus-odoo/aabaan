<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="aabaan_ceo_dashboard.Dashboard">
    <div class="o_aabaan_dash">
        <div class="o_aabaan_dash_mast">
            <div class="o_aabaan_dash_slash"/>
            <div class="o_aabaan_dash_mast_in">
                <div>
                    <div class="brand">Aab<span class="a">a</span>n <span class="light">Services</span></div>
                    <div class="tag">One stop for every service need</div>
                </div>
                <div class="right">
                    <div class="ttl">CEO Dashboard</div>
                    <div class="asof" t-if="state.data">
                        Live from database · <t t-out="state.data.as_of"/>
                        <button class="rfr" t-on-click="() => this.refresh()" title="Reload all figures">⟳ Refresh</button>
                    </div>
                </div>
            </div>
        </div>

        <div t-if="state.error" class="o_aabaan_dash_state error">
            Could not load the dashboard: <t t-out="state.error"/>
        </div>
        <div t-elif="!state.data" class="o_aabaan_dash_state">Loading…</div>

        <div t-else="" class="o_aabaan_dash_body">
            <!-- KPI tiles -->
            <div class="o_aabaan_dash_tiles">
                <button class="tile hero" t-on-click="() => this.open(state.data.book)">
                    <span class="k">Contracted book — confirmed orders</span>
                    <span class="v"><t t-out="money(state.data.book.gross)"/></span>
                    <span class="d">
                        <t t-out="state.data.book.count"/> contracts ·
                        <t t-out="money(state.data.book.net)"/> net of VAT
                    </span>
                    <span class="d muted" t-if="!state.data.book.count">
                        No confirmed contracts yet — the book fills as contracts are entered or imported.
                    </span>
                    <span class="hint">Open contracts</span>
                </button>

                <button class="tile" t-on-click="() => this.open(state.data.quotes)">
                    <span class="k">Open quotations</span>
                    <span class="v"><t t-out="money(state.data.quotes.gross)"/></span>
                    <span class="d"><t t-out="state.data.quotes.count"/> awaiting signature</span>
                    <span class="hint">Open list</span>
                </button>

                <button class="tile" t-if="state.data.pipeline.model" t-on-click="() => this.open(state.data.pipeline)">
                    <span class="k">Sales pipeline</span>
                    <span class="v"><t t-out="money(state.data.pipeline.expected)"/></span>
                    <span class="d"><t t-out="state.data.pipeline.count"/> open leads &amp; opportunities</span>
                    <span class="hint">Open pipeline</span>
                </button>

                <button class="tile" t-on-click="() => this.open(state.data.ar)">
                    <span class="k">Receivables outstanding</span>
                    <span class="v"><t t-out="money(state.data.ar.residual)"/></span>
                    <span class="d">
                        <span t-if="state.data.ar.overdue_count" class="crit">
                            <t t-out="money(state.data.ar.overdue)"/> overdue (<t t-out="state.data.ar.overdue_count"/>)
                        </span>
                        <span t-else="">No overdue invoices</span>
                    </span>
                    <span class="hint">Open invoices</span>
                </button>

                <button class="tile" t-on-click="() => this.open(state.data.customers)">
                    <span class="k">Customers</span>
                    <span class="v"><t t-out="state.data.customers.count"/></span>
                    <span class="d">with at least one sale</span>
                    <span class="hint">Open customers</span>
                </button>
            </div>

            <div class="o_aabaan_dash_grid">
                <!-- This month vs last month -->
                <div class="card wide">
                    <h2>This month — with last month beside it</h2>
                    <div class="renew">
                        <button class="rn" t-on-click="() => this.open(state.data.this_month.new_book)">
                            <span class="k">New contracts signed</span>
                            <span class="v"><t t-out="money(state.data.this_month.new_book.gross)"/></span>
                            <span class="d"><t t-out="state.data.this_month.new_book.count"/> signed ·
                                last month <t t-out="money(state.data.last_month.new_book.gross)"/>
                                (<t t-out="state.data.last_month.new_book.count"/>)</span>
                        </button>
                        <button class="rn" t-on-click="() => this.open(state.data.this_month.invoiced)">
                            <span class="k">Invoiced, net of VAT</span>
                            <span class="v"><t t-out="money(state.data.this_month.invoiced.gross)"/></span>
                            <span class="d"><t t-out="state.data.this_month.invoiced.count"/> invoices ·
                                last month <t t-out="money(state.data.last_month.invoiced.gross)"/></span>
                        </button>
                        <button class="rn" t-on-click="() => this.open(state.data.this_month.collected)">
                            <span class="k">Cash collected</span>
                            <span class="v"><t t-out="money(state.data.this_month.collected.gross)"/></span>
                            <span class="d"><t t-out="state.data.this_month.collected.count"/> payments ·
                                last month <t t-out="money(state.data.last_month.collected.gross)"/></span>
                        </button>
                        <button class="rn" t-if="state.data.this_month.leads"
                                t-on-click="() => this.open(state.data.this_month.leads)">
                            <span class="k">New leads</span>
                            <span class="v"><t t-out="state.data.this_month.leads.count"/></span>
                            <span class="d">last month <t t-out="state.data.last_month.leads ? state.data.last_month.leads.count : 0"/></span>
                        </button>
                    </div>
                </div>

                <!-- Top customers -->
                <div class="card">
                    <h2>Top customers — share of the book</h2>
                    <div t-if="!state.data.top_customers.length" class="empty">
                        Populates with the first confirmed contracts.
                    </div>
                    <div class="bars">
                        <button class="bar" t-foreach="state.data.top_customers" t-as="item" t-key="item.key"
                                t-on-click="() => this.open(item)">
                            <span class="lbl" t-out="item.label"/>
                            <span class="track"><span class="fill s1" t-attf-style="width: {{ barWidth(state.data.top_customers, item) }}%"/></span>
                            <span class="num"><t t-out="money(item.gross)"/> · <t t-out="item.share"/>%</span>
                        </button>
                    </div>
                </div>

                <!-- Cash collected trend -->
                <div class="card wide">
                    <h2>Cash collected — last 12 months</h2>
                    <div t-if="!state.data.collections_months.some(m => m.count)" class="empty">
                        Populates as customer payments are registered.
                    </div>
                    <div class="months" t-else="">
                        <button class="mcol" t-foreach="state.data.collections_months" t-as="item" t-key="item.key"
                                t-on-click="() => this.open(item)"
                                t-att-title="item.label + ': ' + money(item.gross) + ' / ' + item.count + ' payments'">
                            <span class="mv" t-out="item.count ? fmt(item.gross) : ''"/>
                            <span class="mtrack">
                                <span class="mfill" t-attf-style="height: {{ monthHeight(state.data.collections_months, item) }}%"/>
                            </span>
                            <span class="ml" t-out="item.label"/>
                        </button>
                    </div>
                </div>

                <!-- Service lines -->
                <div class="card">
                    <h2>Book by service line</h2>
                    <div t-if="!state.data.service_lines.length" class="empty">
                        Populates once confirmed contracts carry a service line.
                    </div>
                    <div class="bars">
                        <button class="bar" t-foreach="state.data.service_lines" t-as="item" t-key="item.key"
                                t-on-click="() => this.open(item)">
                            <span class="lbl" t-out="item.label"/>
                            <span class="track"><span class="fill s1" t-attf-style="width: {{ barWidth(state.data.service_lines, item) }}%"/></span>
                            <span class="num"><t t-out="money(item.gross)"/> · <t t-out="item.count"/></span>
                        </button>
                    </div>
                </div>

                <!-- Emirates -->
                <div class="card">
                    <h2>Book by emirate regime</h2>
                    <div t-if="!state.data.emirates.length" class="empty">
                        Populates once confirmed contracts carry an emirate regime.
                    </div>
                    <div class="bars">
                        <button class="bar" t-foreach="state.data.emirates" t-as="item" t-key="item.key"
                                t-on-click="() => this.open(item)">
                            <span class="lbl" t-out="item.label"/>
                            <span class="track"><span class="fill s1" t-attf-style="width: {{ barWidth(state.data.emirates, item) }}%"/></span>
                            <span class="num"><t t-out="money(item.gross)"/> · <t t-out="item.count"/></span>
                        </button>
                    </div>
                </div>

                <!-- Client industry -->
                <div class="card">
                    <h2>Book by client industry</h2>
                    <div t-if="!state.data.industries.length" class="empty">
                        Populates once customers carry an Industry (set it on the
                        contact form; it is imported with the customer master).
                    </div>
                    <div class="bars">
                        <button class="bar" t-foreach="state.data.industries.slice(0, 8)" t-as="item" t-key="item.key"
                                t-on-click="() => this.open(item)">
                            <span class="lbl" t-out="item.label"/>
                            <span class="track"><span class="fill s1" t-attf-style="width: {{ barWidth(state.data.industries, item) }}%"/></span>
                            <span class="num"><t t-out="money(item.gross)"/> · <t t-out="item.count"/></span>
                        </button>
                    </div>
                </div>

                <!-- Contract size mix -->
                <div class="card">
                    <h2>Contract size mix</h2>
                    <div t-if="!state.data.book.count" class="empty">
                        Populates with the first confirmed contracts.
                    </div>
                    <div class="bars">
                        <button class="bar" t-foreach="state.data.size_bands" t-as="item" t-key="item.key"
                                t-on-click="() => this.open(item)">
                            <span class="lbl" t-out="item.label"/>
                            <span class="track"><span class="fill s1" t-attf-style="width: {{ barWidth(state.data.size_bands, item) }}%"/></span>
                            <span class="num"><t t-out="money(item.gross)"/> · <t t-out="item.count"/></span>
                        </button>
                    </div>
                </div>

                <!-- Renewals -->
                <div class="card wide" t-if="state.data.renewals.length">
                    <h2>Renewal pipeline</h2>
                    <div class="renew">
                        <button t-foreach="state.data.renewals" t-as="item" t-key="item.key"
                                t-attf-class="rn {{ item.status or '' }}" t-on-click="() => this.open(item)">
                            <span class="k" t-out="item.label"/>
                            <span class="v" t-out="money(item.gross)"/>
                            <span class="d"><t t-out="item.count"/> contracts</span>
                        </button>
                    </div>
                    <div class="months" t-if="state.data.renewal_months.length">
                        <button class="mcol" t-foreach="state.data.renewal_months" t-as="item" t-key="item.key"
                                t-on-click="() => this.open(item)"
                                t-att-title="item.label + ': ' + money(item.gross) + ' / ' + item.count + ' contracts'">
                            <span class="mv" t-out="item.count ? fmt(item.gross) : ''"/>
                            <span class="mtrack">
                                <span t-attf-class="mfill {{ item.status or '' }}"
                                      t-attf-style="height: {{ monthHeight(state.data.renewal_months, item) }}%"/>
                            </span>
                            <span class="ml" t-out="item.label"/>
                        </button>
                    </div>
                </div>

                <!-- Revenue trend -->
                <div class="card wide">
                    <h2>Invoiced revenue — last 12 months</h2>
                    <div t-if="!state.data.revenue_months.some(m => m.count)" class="empty">
                        Populates as customer invoices are posted. Net of VAT; credit notes deduct.
                    </div>
                    <div class="months" t-else="">
                        <button class="mcol" t-foreach="state.data.revenue_months" t-as="item" t-key="item.key"
                                t-on-click="() => this.open(item)"
                                t-att-title="item.label + ': ' + money(item.gross) + ' / ' + item.count + ' invoices'">
                            <span class="mv" t-out="item.count ? fmt(item.gross) : ''"/>
                            <span class="mtrack">
                                <span class="mfill" t-attf-style="height: {{ monthHeight(state.data.revenue_months, item) }}%"/>
                            </span>
                            <span class="ml" t-out="item.label"/>
                        </button>
                    </div>
                </div>

                <!-- Top technicians -->
                <div class="card">
                    <h2>Top technicians — visits completed</h2>
                    <div t-if="!state.data.technicians.length" class="empty">
                        Populates once technicians are assigned and complete visits
                        (Start / Complete buttons on the visit).
                    </div>
                    <div class="bars">
                        <button class="bar" t-foreach="state.data.technicians" t-as="item" t-key="item.key"
                                t-on-click="() => this.open(item)">
                            <span class="lbl" t-out="item.label"/>
                            <span class="track"><span class="fill s1" t-attf-style="width: {{ barCount(state.data.technicians, item) }}%"/></span>
                            <span class="num"><t t-out="item.count"/> done · <t t-out="item.open"/> open</span>
                        </button>
                    </div>
                </div>

                <!-- Jobs by emirate -->
                <div class="card">
                    <h2>Visit workload by emirate</h2>
                    <div t-if="!state.data.visit_emirates.length" class="empty">
                        Populates once visits exist for contracts carrying an emirate regime.
                    </div>
                    <div class="bars">
                        <button class="bar" t-foreach="state.data.visit_emirates" t-as="item" t-key="item.key"
                                t-on-click="() => this.open(item)">
                            <span class="lbl" t-out="item.label"/>
                            <span class="track"><span class="fill s1" t-attf-style="width: {{ barCount(state.data.visit_emirates, item) }}%"/></span>
                            <span class="num"><t t-out="item.count"/> visits · <t t-out="item.open"/> open</span>
                        </button>
                    </div>
                </div>

                <!-- Visits -->
                <div class="card wide">
                    <h2>Field service</h2>
                    <div t-if="!state.data.visits.by_type.length and !state.data.visits.cards.length" class="empty">
                        Visit metrics populate once the Field Service schedule is generated.
                    </div>
                    <div class="chips" t-if="state.data.visits.by_type.length or state.data.fnb">
                        <button class="chipbtn" t-foreach="state.data.visits.by_type" t-as="item" t-key="item.key"
                                t-on-click="() => this.open(item)">
                            <span t-out="item.label"/> <b t-out="item.count"/>
                        </button>
                        <button class="chipbtn" t-if="state.data.fnb"
                                t-on-click="() => this.open(state.data.fnb)">
                            <span t-out="state.data.fnb.label"/> <b t-out="state.data.fnb.count"/>
                        </button>
                    </div>
                    <div class="renew" t-if="state.data.visits.cards.length">
                        <button t-foreach="state.data.visits.cards" t-as="item" t-key="item.key"
                                t-attf-class="rn {{ item.status or '' }}" t-on-click="() => this.open(item)">
                            <span class="k" t-out="item.label"/>
                            <span class="v" t-out="item.count"/>
                            <span class="d">tasks</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</t>

</templates>
